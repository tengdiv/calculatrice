<Application x:Class="Calculatrice.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- Palette -->
    <SolidColorBrush x:Key="Bg" Color="#0F1420"/>
    <SolidColorBrush x:Key="KeyBg" Color="#1E2740"/>
    <SolidColorBrush x:Key="KeyAltBg" Color="#2A3558"/>
    <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>
    <SolidColorBrush x:Key="Txt" Color="#E8ECF5"/>
    <SolidColorBrush x:Key="Muted" Color="#8B96B3"/>

    <!-- Tous les TextBlock : texte clair, police Windows 11 -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Txt}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    </Style>

    <!-- Bouton de base (chiffres) -->
    <Style x:Key="CalcButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource KeyBg}"/>
      <Setter Property="Foreground" Value="{StaticResource Txt}"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="14"/>
              <Border x:Name="Overlay" Background="White" Opacity="0" CornerRadius="14"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Overlay" Property="Opacity" Value="0.08"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Overlay" Property="Opacity" Value="0.18"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Variante : C, ⌫, % -->
    <Style x:Key="AltButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
      <Setter Property="Background" Value="{StaticResource KeyAltBg}"/>
    </Style>

    <!-- Variante : opérateurs et = -->
    <Style x:Key="OpButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

  </Application.Resources>
</Application>