<Window x:Class="Calculatrice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculatrice" Width="360" Height="580" MinWidth="320" MinHeight="520"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Affichage -->
    <StackPanel Grid.Row="0" Margin="8,16,8,16">
      <TextBlock x:Name="ExprText" Text="" Foreground="{StaticResource Muted}" FontSize="16"
                 HorizontalAlignment="Right" Height="24"/>
      <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Height="72">
        <TextBlock x:Name="DisplayText" Text="0" FontSize="56" FontWeight="SemiBold"/>
      </Viewbox>
    </StackPanel>

    <!-- Clavier : 5 lignes x 4 colonnes -->
    <UniformGrid Grid.Row="1" Rows="5" Columns="4">
      <Button Content="C" Tag="C"  Style="{StaticResource AltButton}"/>
      <Button Content="⌫" Tag="BS" Style="{StaticResource AltButton}"/>
      <Button Content="%" Tag="%"  Style="{StaticResource AltButton}"/>
      <Button Content="÷" Tag="÷"  Style="{StaticResource OpButton}"/>

      <Button Content="7" Tag="7" Style="{StaticResource CalcButton}"/>
      <Button Content="8" Tag="8" Style="{StaticResource CalcButton}"/>
      <Button Content="9" Tag="9" Style="{StaticResource CalcButton}"/>
      <Button Content="×" Tag="×" Style="{StaticResource OpButton}"/>

      <Button Content="4" Tag="4" Style="{StaticResource CalcButton}"/>
      <Button Content="5" Tag="5" Style="{StaticResource CalcButton}"/>
      <Button Content="6" Tag="6" Style="{StaticResource CalcButton}"/>
      <Button Content="−" Tag="-" Style="{StaticResource OpButton}"/>

      <Button Content="1" Tag="1" Style="{StaticResource CalcButton}"/>
      <Button Content="2" Tag="2" Style="{StaticResource CalcButton}"/>
      <Button Content="3" Tag="3" Style="{StaticResource CalcButton}"/>
      <Button Content="+" Tag="+" Style="{StaticResource OpButton}"/>

      <Button Content="±" Tag="NEG" Style="{StaticResource CalcButton}"/>
      <Button Content="0" Tag="0"   Style="{StaticResource CalcButton}"/>
      <Button Content="," Tag="."   Style="{StaticResource CalcButton}"/>
      <Button Content="=" Tag="="   Style="{StaticResource OpButton}"/>
    </UniformGrid>
  </Grid>
</Window>